+@app.get('/node/v1/sites')
+def node_sites(request: Request):
+    """The authoritative site inventory, read-only.
+
+    AIOPS_NODE_SITES_V1. Added 5 September 2026 because the AI agents had no
+    way to see the fleet: /health publishes counts, /fleet/status publishes the
+    four nodes, and neither publishes the sites themselves. sites.yml remains
+    the single source of truth; this route only reads it.
+
+    Only the fields a caller needs to name a target are returned. Anything that
+    is an instruction for the controller rather than a description of the site -
+    wp_cli, run_user, backup_script, deployment_paths, git_repo, worktree_root -
+    is deliberately left out, so a read of the inventory cannot become a map of
+    how to write to it.
+    """
+    try:
+        caller = verify_incoming_request(
+            settings,
+            audit,
+            request.headers,
+            'GET',
+            '/node/v1/sites',
+            b'',
+        )
+        sites = FleetState(settings).sites()
+    except FleetError as exc:
+        raise HTTPException(403, str(exc)) from exc
+
+    public_fields = (
+        'family',
+        'node',
+        'domain',
+        'base_url',
+        'environment',
+        'production_target',
+    )
+    return {
+        'status': 'ok',
+        'requested_by': caller,
+        'count': len(sites),
+        'sites': [
+            {'target_id': target_id, **{k: value.get(k) for k in public_fields}}
+            for target_id, value in sorted(sites.items())
+        ],
+    }
+
+
