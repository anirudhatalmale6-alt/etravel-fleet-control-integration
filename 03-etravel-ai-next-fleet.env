# /etc/etravel-ai-next/fleet.env
#
# Proposed - NOT INSTALLED.
#
# WHY THIS FILE EXISTS
# The ai1 agent runs as the user etravelai. Both secrets it needs are owned by
# somebody else and are unreadable to it:
#
#   /etc/etravel-ai-ops/fleet-node.secret                root:aiops      0640
#   /var/www/vhosts/etravel.gr/private/
#       eto-navigator-api-secret                         etravel_gr:psacln 0600
#
# Adding etravelai to those groups would give the chat agent standing read
# access to every other secret in both directories. Instead systemd reads this
# file as root, before it drops to etravelai, and passes only these values into
# the process environment. The file itself stays unreadable to the service user.
#
# INSTALL
#   install -o root -g root -m 0600 03-etravel-ai-next-fleet.env \
#           /etc/etravel-ai-next/fleet.env
#   then fill in the two values from the files above - by hand, on the server.
#   Never paste either value into chat, a ticket, a commit or a log line.
#
#   mkdir -p /etc/systemd/system/etravel-ai-next.service.d
#   cat > /etc/systemd/system/etravel-ai-next.service.d/fleet.conf <<'EOF'
#   [Service]
#   EnvironmentFile=/etc/etravel-ai-next/fleet.env
#   EOF
#   systemctl daemon-reload && systemctl restart etravel-ai-next.service
#
# The agent checks for these at import time. If ETR_FLEET_NODE_SECRET is absent
# or short, the fleet tools are not registered at all - the model is told
# nothing rather than being given a tool that always fails. A tool that fails
# silently produces "I checked and found nothing", which is a lie.

# The controller's fleet HMAC secret. Same value as
# /etc/etravel-ai-ops/fleet-node.secret.
ETR_FLEET_NODE_SECRET=

# The Operations Navigator secret. Same value as
# /var/www/vhosts/etravel.gr/private/eto-navigator-api-secret.
# Optional: without it, the three fleet tools still register and only
# navigator_search is left out.
ETR_NAVIGATOR_HMAC_SECRET=

# Defaults, listed so they are visible rather than hidden in the code.
ETR_FLEET_CONTROLLER_URL=http://127.0.0.1:8787
ETR_FLEET_CALLER_ID=primary
ETR_FLEET_TIMEOUT=30
ETR_NAVIGATOR_HOST=www.etravel.gr
ETR_NAVIGATOR_ORIGIN_IP=65.21.44.213
ETR_NAVIGATOR_BASE=/wp-json/eto/v1
ETR_FLEET_USER_AGENT=eTravel-AI-Fleet/1.0 (+https://ai1.etravel.gr; server 65.21.44.213)
